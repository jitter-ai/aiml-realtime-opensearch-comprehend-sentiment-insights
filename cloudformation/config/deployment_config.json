{
    "aws": {
        "region": "us-east-1",
        "stack_name": "test"
    },
    "assets": {
        "lambda_function": {
            "local_path": "../lambda_function/all_scripts_lambda.zip",
            "s3_key": "all_scripts_lambda.zip"
        },
        "lambda_layers": {
            "opensearch_py": {
                "local_path": "../lambda_layers/opensearch_py.zip",
                "s3_key": "opensearch_py.zip"
            },
            "requests_aws4auth": {
                "local_path": "../lambda_layers/requests_aws4auth.zip",
                "s3_key": "requests_aws4auth.zip"
            }
        }
    },
    "template_path": "sam.yml",
    "stack_parameters": [
        {
            "ParameterKey": "MyAssetsBucketPrefix",
            "ParameterValue": "aos-sentiment"
        }
    ],
    "stack_capabilities": [
        "CAPABILITY_IAM",
        "CAPABILITY_NAMED_IAM"
    ],
    "waiter_config": {
        "Delay": 10,
        "MaxAttempts": 60
    }
}
